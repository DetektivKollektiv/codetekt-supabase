{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Wedium Community Checks API",
    "version": "1.0.1",
    "description": "Technischer Vertrag der separaten Wedium Community Checks API. Der Fragenkatalog besteht aus 15 kategorisierten Frage-IDs. Aggregationen werden asynchron ab zwei Reviews berechnet und enthalten immer alle 15 Fragen. Bei zwei bis acht Reviews wird jeder Fragenscore um 2 geteilt durch die Reviewanzahl in Richtung Grün korrigiert; ab neun Reviews entfällt die Korrektur."
  },
  "servers": [
    {
      "url": "https://{projectRef}.supabase.co/functions/v1/wedium",
      "description": "Supabase-Projekt",
      "variables": {
        "projectRef": {
          "default": "your-project-ref",
          "description": "Supabase Project Reference"
        }
      }
    },
    {
      "url": "http://127.0.0.1:54321/functions/v1/wedium",
      "description": "Lokale Supabase-Instanz"
    }
  ],
  "security": [
    {
      "WediumApiKey": []
    }
  ],
  "tags": [
    {
      "name": "Aggregations",
      "description": "Veröffentlichte Community-Ergebnisse"
    },
    {
      "name": "Reviews",
      "description": "Aktuelles Review eines pseudonymisierten Users für einen Post"
    },
    {
      "name": "Users",
      "description": "Pseudonymisierte Wedium-User"
    }
  ],
  "paths": {
    "/review-aggregations": {
      "post": {
        "operationId": "getWediumReviewAggregations",
        "tags": [
          "Aggregations"
        ],
        "summary": "Aggregationen mehrerer Posts abrufen",
        "description": "Gibt vorhandene Aggregationen in der Reihenfolge der angefragten Post-Hashes zurück. Nicht vorhandene Posts und Posts ohne veröffentlichbares Aggregat erscheinen in `missing_post_hashes`. Der Endpunkt stößt keine Neuberechnung an. Nach einem PUT kann bis zur nächsten erfolgreichen Berechnung noch das vorherige Aggregat sichtbar sein; nach einem DELETE bleibt der Post bis zur Neuberechnung `missing`. Bereits gespeicherte Aggregate werden erst mit der nächsten Review-Änderung nach der aktuellen Berechnungslogik neu erstellt.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AggregationRequest"
              },
              "example": {
                "post_hashes": [
                  "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Vorhandene und fehlende Aggregationen",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AggregationResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/users/{user_hash}/reviews/{post_hash}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserHash"
        },
        {
          "$ref": "#/components/parameters/PostHash"
        }
      ],
      "put": {
        "operationId": "putWediumReview",
        "tags": [
          "Reviews"
        ],
        "summary": "Review speichern oder vollständig überschreiben",
        "description": "Legt User und Post bei Bedarf an. Ein vorhandenes Review desselben Users für denselben Post wird vollständig ersetzt. Jede erfolgreiche Änderung stößt die asynchrone Neuberechnung an.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewUpsertRequest"
              },
              "example": {
                "answers": {
                  "content_false_context": 1,
                  "content_contradictory": 2,
                  "content_covert_advertising": 3,
                  "content_clickbait": 1,
                  "content_deepfake": 0,
                  "presentation_derogatory": 1,
                  "presentation_aggressive": 2,
                  "presentation_fear_inducing": 0,
                  "presentation_generalizing": 1,
                  "account_biased": 2,
                  "account_unclear_identity": 0,
                  "account_impersonated_identity": 1,
                  "sources_unreliable": 2,
                  "sources_debunked": 3,
                  "sources_missing": 1
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Review gespeichert",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewSavedResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "get": {
        "operationId": "getWediumReview",
        "tags": [
          "Reviews"
        ],
        "summary": "Review abrufen",
        "responses": {
          "200": {
            "description": "Aktuelles Review",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "operationId": "deleteWediumReview",
        "tags": [
          "Reviews"
        ],
        "summary": "Review löschen",
        "description": "Idempotent. Der Wedium-User bleibt bestehen. Ein entferntes Aggregat bleibt bis zur erfolgreichen Neuberechnung `missing`.",
        "responses": {
          "200": {
            "description": "Löschstatus",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteReviewResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    },
    "/users/{user_hash}": {
      "parameters": [
        {
          "$ref": "#/components/parameters/UserHash"
        }
      ],
      "get": {
        "operationId": "getWediumUser",
        "tags": [
          "Users"
        ],
        "summary": "User abrufen",
        "responses": {
          "200": {
            "description": "User-Metadaten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      },
      "delete": {
        "operationId": "deleteWediumUser",
        "tags": [
          "Users"
        ],
        "summary": "User und dessen Reviews löschen",
        "description": "Idempotent. Posts bleiben bestehen. Alle Reviews des Users werden entfernt und die betroffenen Aggregationen asynchron neu berechnet.",
        "responses": {
          "200": {
            "description": "Löschstatus und Anzahl betroffener Reviews und Posts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteUserResponse"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "405": {
            "$ref": "#/components/responses/MethodNotAllowed"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "WediumApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Server-to-Server-Schlüssel aus `WEDIUM_API_KEY`."
      }
    },
    "parameters": {
      "UserHash": {
        "name": "user_hash",
        "in": "path",
        "required": true,
        "description": "Pseudonymisierte User-ID als SHA-256-kompatibler Hex-String.",
        "schema": {
          "$ref": "#/components/schemas/Hash"
        }
      },
      "PostHash": {
        "name": "post_hash",
        "in": "path",
        "required": true,
        "description": "Pseudonymisierte Post-ID als SHA-256-kompatibler Hex-String.",
        "schema": {
          "$ref": "#/components/schemas/Hash"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Fehlender oder ungültiger Wedium API Key",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse"
            },
            "example": {
              "error": {
                "code": "unauthorized",
                "message": "Unauthorized"
              }
            }
          }
        }
      },
      "NotFound": {
        "description": "Ressource nicht gefunden",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse"
            },
            "example": {
              "error": {
                "code": "not_found",
                "message": "Review not found"
              }
            }
          }
        }
      },
      "MethodNotAllowed": {
        "description": "HTTP-Methode für diese Route nicht unterstützt",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse"
            },
            "example": {
              "error": {
                "code": "method_not_allowed",
                "message": "Method not allowed"
              }
            }
          }
        }
      },
      "ValidationError": {
        "description": "Pfadparameter oder Request Body ungültig",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse"
            },
            "example": {
              "error": {
                "code": "validation_error",
                "message": "Invalid review",
                "issues": [
                  {
                    "path": [
                      "answers",
                      "content_deepfake"
                    ],
                    "message": "Invalid input"
                  }
                ]
              }
            }
          }
        }
      },
      "InternalError": {
        "description": "Unerwarteter interner Fehler",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiErrorResponse"
            },
            "example": {
              "error": {
                "code": "internal_error",
                "message": "Internal server error"
              }
            }
          }
        }
      }
    },
    "schemas": {
      "Hash": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$",
        "minLength": 64,
        "maxLength": 64,
        "example": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
      },
      "QuestionId": {
        "type": "string",
        "enum": [
          "content_false_context",
          "content_contradictory",
          "content_covert_advertising",
          "content_clickbait",
          "content_deepfake",
          "presentation_derogatory",
          "presentation_aggressive",
          "presentation_fear_inducing",
          "presentation_generalizing",
          "account_biased",
          "account_unclear_identity",
          "account_impersonated_identity",
          "sources_unreliable",
          "sources_debunked",
          "sources_missing"
        ]
      },
      "RatingValue": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3
        ],
        "description": "0 = passt/unauffällig (Grün), 1 = leicht problematisch (Gelb), 2 = problematisch (Orange), 3 = stark problematisch (Rot)."
      },
      "Answers": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_false_context",
          "content_contradictory",
          "content_covert_advertising",
          "content_clickbait",
          "content_deepfake",
          "presentation_derogatory",
          "presentation_aggressive",
          "presentation_fear_inducing",
          "presentation_generalizing",
          "account_biased",
          "account_unclear_identity",
          "account_impersonated_identity",
          "sources_unreliable",
          "sources_debunked",
          "sources_missing"
        ],
        "properties": {
          "content_false_context": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "content_contradictory": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "content_covert_advertising": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "content_clickbait": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "content_deepfake": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "presentation_derogatory": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "presentation_aggressive": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "presentation_fear_inducing": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "presentation_generalizing": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "account_biased": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "account_unclear_identity": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "account_impersonated_identity": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "sources_unreliable": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "sources_debunked": {
            "$ref": "#/components/schemas/RatingValue"
          },
          "sources_missing": {
            "$ref": "#/components/schemas/RatingValue"
          }
        }
      },
      "ReviewUpsertRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "answers"
        ],
        "properties": {
          "answers": {
            "$ref": "#/components/schemas/Answers"
          }
        }
      },
      "ReviewSavedResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "saved",
          "submitted_at",
          "updated_at"
        ],
        "properties": {
          "saved": {
            "type": "boolean",
            "const": true
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ReviewResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "post_hash",
          "answers",
          "submitted_at",
          "updated_at"
        ],
        "properties": {
          "post_hash": {
            "$ref": "#/components/schemas/Hash"
          },
          "answers": {
            "$ref": "#/components/schemas/Answers"
          },
          "submitted_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "DeleteReviewResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deleted"
        ],
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "`true`, wenn bei diesem Aufruf ein Review gelöscht wurde."
          }
        }
      },
      "UserResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_hash",
          "review_count",
          "created_at",
          "last_reviewed_at"
        ],
        "properties": {
          "user_hash": {
            "$ref": "#/components/schemas/Hash"
          },
          "review_count": {
            "type": "integer",
            "minimum": 0
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "last_reviewed_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "description": "Zeitpunkt des zuletzt aktualisierten Reviews oder `null`, wenn der User keine Reviews hat."
          }
        }
      },
      "DeleteUserResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deleted",
          "deleted_review_count",
          "affected_post_count"
        ],
        "properties": {
          "deleted": {
            "type": "boolean",
            "description": "`true`, wenn bei diesem Aufruf ein User gelöscht wurde."
          },
          "deleted_review_count": {
            "type": "integer",
            "minimum": 0
          },
          "affected_post_count": {
            "type": "integer",
            "minimum": 0,
            "description": "Anzahl der Posts, deren Review-Bestand sich geändert hat. Entspricht wegen genau eines Reviews pro User und Post der Anzahl gelöschter Reviews."
          }
        }
      },
      "AggregationRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "post_hashes"
        ],
        "properties": {
          "post_hashes": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true,
            "items": {
              "$ref": "#/components/schemas/Hash"
            }
          }
        }
      },
      "RatingCounts": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "0",
          "1",
          "2",
          "3"
        ],
        "properties": {
          "0": {
            "type": "integer",
            "minimum": 0
          },
          "1": {
            "type": "integer",
            "minimum": 0
          },
          "2": {
            "type": "integer",
            "minimum": 0
          },
          "3": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "RatingPercentages": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "0",
          "1",
          "2",
          "3"
        ],
        "properties": {
          "0": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "1": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "2": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "3": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        }
      },
      "ResultLevel": {
        "type": "integer",
        "enum": [
          0,
          1,
          2,
          3
        ],
        "description": "Kaufmännisch gerundeter korrigierter Score: 0 = vertrauenswürdig, 1 = eher vertrauenswürdig, 2 = eher nicht vertrauenswürdig, 3 = nicht vertrauenswürdig."
      },
      "ResultCode": {
        "type": "string",
        "enum": [
          "trustworthy",
          "rather_trustworthy",
          "rather_not_trustworthy",
          "not_trustworthy"
        ]
      },
      "AggregationField": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "type",
          "counts",
          "percentages",
          "average",
          "level"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/QuestionId"
          },
          "type": {
            "type": "string",
            "const": "traffic-light"
          },
          "counts": {
            "$ref": "#/components/schemas/RatingCounts"
          },
          "percentages": {
            "$ref": "#/components/schemas/RatingPercentages"
          },
          "average": {
            "type": "number",
            "minimum": 0,
            "maximum": 3,
            "multipleOf": 0.01,
            "description": "Um 2 / Reviewanzahl korrigierter Wert bei zwei bis acht Reviews, auf zwei Dezimalstellen gerundet. Ab neun Reviews entspricht er dem ungekürzten Durchschnitt."
          },
          "level": {
            "$ref": "#/components/schemas/ResultLevel"
          }
        }
      },
      "AggregationQuestion": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score",
          "level",
          "fields"
        ],
        "properties": {
          "id": {
            "$ref": "#/components/schemas/QuestionId"
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 3,
            "multipleOf": 0.01,
            "description": "Korrigierter Fragenscore; entspricht dem `average` des enthaltenen Feldes."
          },
          "level": {
            "$ref": "#/components/schemas/ResultLevel"
          },
          "fields": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1,
            "description": "Enthält aktuell genau ein `traffic-light`-Feld mit derselben ID wie die Frage.",
            "items": {
              "$ref": "#/components/schemas/AggregationField"
            }
          }
        }
      },
      "AggregationData": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "questions"
        ],
        "properties": {
          "questions": {
            "type": "array",
            "minItems": 15,
            "maxItems": 15,
            "description": "Enthält alle 15 Fragen in der Reihenfolge des Fragenkatalogs. Counts und Prozentwerte basieren auf sämtlichen Bewertungen von 0 bis 3; Score und Level enthalten die Korrektur für zwei bis acht Reviews.",
            "items": {
              "$ref": "#/components/schemas/AggregationQuestion"
            }
          }
        }
      },
      "AggregationResult": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "post_hash",
          "review_count",
          "result_score",
          "result_level",
          "result_code",
          "data",
          "calculated_at"
        ],
        "properties": {
          "post_hash": {
            "$ref": "#/components/schemas/Hash"
          },
          "review_count": {
            "type": "integer",
            "minimum": 2,
            "description": "Aus den intern gespeicherten `reviewer_ids` abgeleitet; IDs werden nicht ausgegeben."
          },
          "result_score": {
            "type": "number",
            "minimum": 0,
            "maximum": 3,
            "multipleOf": 0.01,
            "description": "Schlechtester, also höchster korrigierter Score der enthaltenen Fragen."
          },
          "result_level": {
            "$ref": "#/components/schemas/ResultLevel"
          },
          "result_code": {
            "$ref": "#/components/schemas/ResultCode"
          },
          "data": {
            "$ref": "#/components/schemas/AggregationData"
          },
          "calculated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "AggregationResponse": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "results",
          "missing_post_hashes"
        ],
        "properties": {
          "results": {
            "type": "array",
            "maxItems": 100,
            "description": "Vorhandene Ergebnisse in der Reihenfolge der Anfrage.",
            "items": {
              "$ref": "#/components/schemas/AggregationResult"
            }
          },
          "missing_post_hashes": {
            "type": "array",
            "maxItems": 100,
            "description": "Angefragte Hashes ohne veröffentlichbares Aggregat, ebenfalls in Anfragereihenfolge.",
            "items": {
              "$ref": "#/components/schemas/Hash"
            }
          }
        }
      },
      "ApiErrorCode": {
        "type": "string",
        "enum": [
          "unauthorized",
          "not_found",
          "method_not_allowed",
          "validation_error",
          "internal_error"
        ]
      },
      "ApiErrorIssue": {
        "type": "object",
        "description": "Validierungsdetail. Zusätzliche Zod-Felder können enthalten sein.",
        "properties": {
          "path": {
            "type": "array",
